# ──────────────────────────────────────────────────────────────────────────────
# NetLodge .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Local environment files — never commit secrets ───────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# The example template is intentionally tracked.
!.env.example

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── TypeScript / ESLint caches ───────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.cache/

# ── Test artifacts ─────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.nyc_output/
*.lcov

# ── Supabase local ────────────────────────────────────────────────────────────
# Local Supabase CLI state — never commit a local Postgres data dir.
supabase/.branches
supabase/.temp
# Keep supabase/migrations, supabase/seed, supabase/config.toml tracked.

# ── IDE / OS noise ─────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vercel ─────────────────────────────────────────────────────────────────────
.vercel

# ── Reserved project-local tooling (NOT part of NetLodge repo) ─────────────────
# The following directories exist in the workspace for unrelated tooling and
# are intentionally not tracked under the NetLodge repo:
skills/
planning-docs/
upload/
download/
tool-results/
