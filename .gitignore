# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked; ignore real secrets)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Platform infrastructure (not NetLodge code)
/.zscripts/

# Local SQLite database (app uses Supabase/Postgres)
/db/

# One-off upload artifacts (processed logos are in public/)
/upload/

# Tool output dumps
/tool-results/

# Duplicate migration file (supabase/migrations/ is authoritative)
/supabase/combined_migration.sql

# Caddy reverse proxy config (not used in Vercel deployment)
/Caddyfile

# Empty placeholder directory
/mini-services/