# NetLodge environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# ---- Supabase (required) ----
# Project URL (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key (Dashboard → Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key
# Service-role key — SERVER ONLY, never expose to browser (Dashboard → Project Settings → API → service_role)
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key
# Database password (Dashboard → Database → Database password)
# Used only by the migration runner script (scripts/apply-migrations.ts)
SUPABASE_DB_PASSWORD=your_db_password

# ---- Paystack test mode (required) ----
# Test secret key — SERVER ONLY (Paystack Dashboard → Settings → API Keys & Webhooks → Test Secret Key)
# Must start with sk_test_ — the refund function refuses live keys as a safety guard.
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
# Test public key — safe for browser (Paystack Dashboard → Settings → API Keys & Webhooks → Test Public Key)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key

# ---- App (required) ----
# Public site URL (used for Paystack callback URL + CSRF origin validation)
# Must match the deployed domain exactly (e.g. https://netlodge.vercel.app)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Optional: distributed rate limiting ----
# If you deploy to multiple instances (Vercel with >1 replica, Cloud Run, etc.),
# set these to use Upstash Redis for shared rate limiting.
# Without these, rate limiting is per-instance only (in-memory).
# Sensitive endpoints (payment init, refunds, payouts) fail closed if Redis
# is configured but unreachable.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional: cron secret for scheduled reconciliation ----
# Protects the /api/cron/reconciliation endpoint. Generate a strong random
# string (e.g. `openssl rand -hex 32`). Required only if you enable the
# Vercel Cron job configured in vercel.json.
# CRON_SECRET=

# ---- Optional: Google Analytics 4 ----
# GA4 Measurement ID (starts with G-). Public identifier, not a secret.
# If not set, no analytics tracking occurs.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Legacy (unused, can be removed) ----
# The Prisma/SQLite DATABASE_URL is no longer used — Supabase is the sole
# database. Kept for backwards compatibility only.
# DATABASE_URL=file:./db/custom.db
