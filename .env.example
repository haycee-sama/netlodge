# ──────────────────────────────────────────────────────────────────────────────
# NetLodge environment variables — TEMPLATE.
#
# Copy to `.env.local` for local development and populate with real values.
# Never commit `.env.local` or any file containing real secrets.
#
# Reference: IMPLEMENTATION_PLAN.md §25 / TECHNICAL_ARCHITECTURE.md §32
# ──────────────────────────────────────────────────────────────────────────────

# ── Client-safe (NEXT_PUBLIC_*) — bundled in the browser ──────────────────────
# These are safe to expose: RLS (not key secrecy) protects Supabase data, and
# the Paystack public key is by design a client-side value.

# Required. Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Required. Supabase anon key — RLS-scoped. Safe to bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required. Paystack public key — used by the client-side checkout widget.
# Test-mode key in development; live key in production only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Required (Phase 2+). Public site URL — used for email-verification and
# password-reset redirects. In local dev, this is the Next.js dev server URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only (no NEXT_PUBLIC_ prefix) — NEVER bundled in the browser ────────
# These MUST NOT be prefixed with NEXT_PUBLIC_. The `server-only` import guard
# and the lack of NEXT_PUBLIC_ prefix together enforce that they never reach
# a client bundle.

# Required. Supabase service-role key — bypasses RLS entirely. Used ONLY by
# `src/server/supabase/privileged.ts` for narrowly-scoped privileged
# operations (admin actions, webhook processing). NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required. Paystack secret key — server-to-server transaction initialization
# and the independent transaction-verification API call.
PAYSTACK_SECRET_KEY=

# Required. Paystack webhook secret — HMAC signature verification for the
# webhook Route Handler. The first operation in the webhook handler checks
# the signature against this value, before any payload field is read.
PAYSTACK_WEBHOOK_SECRET=

# Optional in Phase 0; required by Phase 11 (Notifications).
# API key for the transactional email provider.
EMAIL_PROVIDER_API_KEY=

# ── Optional runtime configuration ────────────────────────────────────────────
# Reserved for Phase 8/9 — hold-window duration, file-size ceilings, rate
# limits. These are implementation-detail configuration values, not product
# decisions — see TECHNICAL_ARCHITECTURE.md §41. They are intentionally NOT
# set here so they are not mistaken for authoritative values.
