# NetLodge environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is gitignored.

# ---- Supabase (required) ----
# Project URL (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key (Dashboard → Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key
# Service-role key — SERVER ONLY, never expose to browser (Dashboard → Project Settings → API → service_role)
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key
# Database password (Dashboard → Database → Database password)
# Used only by the migration runner script (scripts/apply-migrations.ts)
SUPABASE_DB_PASSWORD=your_db_password

# ---- Paystack test mode (required) ----
# Test secret key — SERVER ONLY (Paystack Dashboard → Settings → API Keys & Webhooks → Test Secret Key)
# Must start with sk_test_ — the refund function refuses live keys as a safety guard.
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
# Test public key — safe for browser (Paystack Dashboard → Settings → API Keys & Webhooks → Test Public Key)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key

# ---- App (required) ----
# Public site URL (used for Paystack callback URL + CSRF origin validation)
# Must match the deployed domain exactly. For Vercel, use your production URL
# (e.g. https://netlodge.vercel.app or your custom domain).
# Preview deployments (*.vercel.app) are automatically allowed by the CSRF check.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Optional: distributed rate limiting ----
# If you deploy to multiple instances (Vercel with >1 replica, Cloud Run, etc.),
# set these to use Upstash Redis for shared rate limiting.
# Without these, rate limiting is per-instance only (in-memory).
# Sensitive endpoints (payment init, refunds, payouts) fail closed if Redis
# is configured but unreachable.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional: cron secret for scheduled reconciliation ----
# Protects the /api/cron/reconciliation endpoint. Generate a strong random
# string (e.g. `openssl rand -hex 32`). Required only if you enable the
# Vercel Cron job configured in vercel.json.
# CRON_SECRET=

# ---- Optional: Google Analytics 4 ----
# GA4 Measurement ID (starts with G-). Public identifier, not a secret.
# If not set, no analytics tracking occurs.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Optional: test database isolation (for running test scripts) ----
# The test guard (scripts/_test-guard.ts) refuses to run database-writing
# tests against the known production project. To run tests against a
# separate test project, point NEXT_PUBLIC_SUPABASE_URL at the test project
# and set NETLODGE_TEST_DB to that project's ref.
# NEVER set NETLODGE_ALLOW_PROD_TESTS=1 in production environments.
# NETLODGE_TEST_DB=
# NETLODGE_ALLOW_PROD_TESTS=

# ---- Optional: bootstrap escape hatch ----
# scripts/bootstrap-supabase.ts refuses to bootstrap the known production
# project unless NETLODGE_BOOTSTRAP_ALLOW_PROD=1 is set. The bootstrap
# script is idempotent, but running it against production is risky.
# NEVER set NETLODGE_BOOTSTRAP_ALLOW_PROD=1 in production environments.
# NETLODGE_BOOTSTRAP_ALLOW_PROD=

# ---- Optional: explicit Supabase pooler region (for migration runner) ----
# If your Supabase project is in a region not covered by the common defaults
# (eu-west-1, us-east-1, us-west-1, ap-southeast-1, eu-central-1,
# ap-northeast-1, sa-east-1), set this to your pooler hostname.
# Example: aws-0-ap-southeast-2.pooler.supabase.com
# SUPABASE_POOLER_HOST=

# ---- Email notifications (Resend) ----
# Get an API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in Resend
# RESEND_FROM_EMAIL=notifications@netlodge.com
# ---- Public-facing support contact (shown in footer + contact page) ----
# NEXT_PUBLIC_SUPPORT_EMAIL=support@netlodge.com
# NEXT_PUBLIC_SUPPORT_PHONE=+234 1 234 5678
# NEXT_PUBLIC_BUSINESS_ADDRESS=Yaba, Lagos, Nigeria
